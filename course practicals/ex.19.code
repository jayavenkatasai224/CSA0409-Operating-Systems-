#include <stdio.h>

int main() {
    int block[10], process[10], allocation[10];
    int n, m, choice, i, j, pos;

    printf("Enter number of memory blocks: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &m);

    printf("Enter process sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &process[i]);

    for(i = 0; i < m; i++)
        allocation[i] = -1;

    printf("\n1. First Fit\n2. Best Fit\n3. Worst Fit\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

    for(i = 0; i < m; i++) {
        pos = -1;

        for(j = 0; j < n; j++) {
            if(block[j] >= process[i]) {

                if(choice == 1) {          // First Fit
                    pos = j;
                    break;
                }

                if(choice == 2) {          // Best Fit
                    if(pos == -1 || block[j] < block[pos])
                        pos = j;
                }

                if(choice == 3) {          // Worst Fit
                    if(pos == -1 || block[j] > block[pos])
                        pos = j;
                }
            }
        }

        if(pos != -1) {
            allocation[i] = pos;
            block[pos] -= process[i];
        }
    }

    printf("\nProcess\tBlock\n");

    for(i = 0; i < m; i++) {
        if(allocation[i] != -1)
            printf("%d\t%d\n", i + 1, allocation[i] + 1);
        else
            printf("%d\tNot Allocated\n", i + 1);
    }

    return 0;
}
