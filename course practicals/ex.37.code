#include <stdio.h>
#include <stdlib.h>

int main() {
    int a[20], n, head, total = 0, i;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    for(i = 0; i < n; i++) {
        total += abs(a[i] - head);
        head = a[i];
    }

    printf("Total head movement = %d", total);

    return 0;
}
