#include <stdio.h>
#include <stdlib.h>

int main() {
    int a[20], n, head, total = 0;
    int i, j, temp;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter head position: ");
    scanf("%d", &head);

    // Sort requests
    for(i = 0; i < n; i++)
        for(j = i + 1; j < n; j++)
            if(a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    // Service requests to the right
    for(i = 0; i < n; i++) {
        if(a[i] >= head) {
            total += abs(a[i] - head);
            head = a[i];
        }
    }

    // Jump to the beginning and service remaining
    for(i = 0; i < n; i++) {
        if(a[i] < head) {
            total += abs(a[i] - head);
            head = a[i];
        }
    }

    printf("Total head movement = %d", total);

    return 0;
}
