#include <stdio.h>

int main() {
    int bt[5], rem[5], tq, i;

    printf("Enter Burst Times:\n");

    for(i=0;i<3;i++) {
        scanf("%d",&bt[i]);
        rem[i]=bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d",&tq);

    printf("Execution:\n");

    while(1) {
        int done=1;

        for(i=0;i<3;i++) {
            if(rem[i]>0) {
                done=0;

                if(rem[i]>tq)
                    rem[i]-=tq;
                else
                    rem[i]=0;

                printf("P%d ",i+1);
            }
        }

        if(done)
            break;
    }

    return 0;
}
