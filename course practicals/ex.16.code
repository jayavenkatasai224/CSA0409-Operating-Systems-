#include <stdio.h>

int main() {
    int block[10], process[10], n, m, i, j, worst, allocation[10];

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block sizes:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &m);

    printf("Enter process sizes:\n");
    for(i = 0; i < m; i++) {
        scanf("%d", &process[i]);
        allocation[i] = -1;
    }

    for(i = 0; i < m; i++) {
        worst = -1;

        for(j = 0; j < n; j++) {
            if(block[j] >= process[i]) {
                if(worst == -1 || block[j] > block[worst])
                    worst = j;
            }
        }

        if(worst != -1) {
            allocation[i] = worst;
            block[worst] -= process[i];
        }
    }

    printf("\nProcess\tBlock\n");
    for(i = 0; i < m; i++) {
        if(allocation[i] != -1)
            printf("%d\t%d\n", i + 1, allocation[i] + 1);
        else
            printf("%d\tNot Allocated\n", i + 1);
    }

    return 0;
}
