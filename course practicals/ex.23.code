#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    struct stat st;
    struct dirent *entry;
    DIR *dir;

    // fcntl and lseek
    fd = open("file.txt", O_RDWR | O_CREAT, 0644);

    write(fd, "Hello UNIX", 10);

    fcntl(fd, F_GETFL);
    printf("fcntl() executed successfully\n");

    lseek(fd, 0, SEEK_SET);
    printf("File pointer moved using lseek()\n");

    // stat
    stat("file.txt", &st);
    printf("File size: %ld bytes\n", st.st_size);

    close(fd);

    // opendir and readdir
    dir = opendir(".");

    printf("\nFiles in current directory:\n");

    while((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(dir);

    return 0;
}
