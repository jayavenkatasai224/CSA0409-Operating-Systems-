#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd;
    char buffer[20];

    // Create and open file
    fd = open("file.txt", O_CREAT | O_RDWR, 0644);

    // Write into file
    write(fd, "Hello UNIX", 10);

    // Move file pointer to beginning
    lseek(fd, 0, SEEK_SET);

    // Read from file
    read(fd, buffer, 10);
    buffer[10] = '\0';

    printf("File Content: %s\n", buffer);

    // Close file
    close(fd);

    return 0;
}
