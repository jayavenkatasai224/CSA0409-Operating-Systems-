#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char line[100], word[50];

    fp = fopen("file.txt", "r");

    if(fp == NULL) {
        printf("File not found");
        return 0;
    }

    printf("Enter word to search: ");
    scanf("%s", word);

    while(fgets(line, 100, fp) != NULL) {
        if(strstr(line, word) != NULL)
            printf("%s", line);
    }

    fclose(fp);
    return 0;
}
