#include <stdio.h>

int main() {
    int bt[5], wt[5], tat[5], i, n;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++) {
        printf("BT of P%d: ",i+1);
        scanf("%d",&bt[i]);
    }

    wt[0]=0;

    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];

    printf("\nP\tWT\tTAT\n");

    for(i=0;i<n;i++) {
        tat[i]=wt[i]+bt[i];
        printf("P%d\t%d\t%d\n",i+1,wt[i],tat[i]);
    }

    return 0;
}
