1. [C]
        program to create child pid and parent pid

                         #include <stdio.h>
                         #include <unistd.h>
                          int main() {
                                 pid_t pid = fork()
                                 if (pid == 0) {
                                           printf("Child Process\n");
                                           printf("Child PID: %d\n", getpid());
                                    } else {
                                            printf("Parent Process\n");
                                            printf("Parent PID: %d\n", getpid());
                                    } 
                                       return 0;
                                       }
